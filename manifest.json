{
   "manifest_version": 3,
   "version": "1.1.0",
   "name": "AI RTL Fix",
   "description": "Fixes RTL text formatting, bullet points, and KaTeX math rendering natively on Claude, Gemini, and ChatGPT.",
   "author": "Yuval Anteby",
   "homepage_url": "https://github.com/YuvalAnteby/AI-RTL-Fix",
   "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   },
   "content_scripts": [ 
      {
         "matches": [ 
            "*://*.claude.ai/*", 
            "*://gemini.google.com/*", 
            "*://chatgpt.com/*",
            "*://*.chatgpt.com/*"
         ],
         "css": [ "styles.css" ],
         "js": [ "content.js" ],
         "run_at": "document_end"
      } 
   ],
   "browser_specific_settings": {
      "gecko": {
         "id": "ai-rtl-fix@yuvalanteby.com",
         "strict_min_version": "109.0"
      }
   }   
}
